---
const habilidades = [
  { area: 'Business Intelligence', items: ['Power BI', 'ETL', 'Modelado dimensional', 'Datamart'] },
  { area: 'Lenguajes', items: ['Python', 'SQL', 'C++', 'PHP', 'JavaScript'] },
  { area: 'Análisis de Datos', items: ['Excel avanzado', 'Estadística descriptiva'] },
  { area: 'Machine Learning', items: ['Forecast', 'Regresión', 'Clasificación'] },
  { area: 'Herramientas', items: ['Git', 'GitHub', 'SQL Workbench', 'StarUML', 'Scratch'] },
  { area: 'Frontend', items: ['Astro', 'Tailwind CSS', 'HTML/CSS'] },
];
---

<section id="perfil" class="py-32 px-6 bg-black border-t border-zinc-900">
  <div class="max-w-7xl mx-auto">
    <p class="text-cyan-400 font-mono text-sm mb-4 tracking-widest uppercase">01 — Perfil</p>
    <h2 class="text-5xl md:text-7xl font-bold text-white leading-tight mb-16 max-w-3xl">
      Analista de datos con foco en <span class="text-cyan-400">impacto real</span>.
    </h2>

    <div class="grid md:grid-cols-2 gap-16">
      <div class="space-y-6 text-lg text-zinc-400 leading-relaxed">
        <p>
          Egresado de Ingeniería en Programación con formación en
          <span class="text-white font-semibold">Business Intelligence</span>.
          Me especializo en transformar datos crudos en información útil para la
          toma de decisiones.
        </p>
        <p>
          Combino análisis descriptivo, predictivo y visualización de datos con
          herramientas como <span class="text-white font-semibold">Power BI, Python y SQL</span>,
          construyendo soluciones desde el ETL hasta el dashboard final.
        </p>
        <p>
          Mi enfoque está en el análisis aplicado: tomar problemas reales —
          territoriales, económicos, sociales — y generar hallazgos accionables
          para quien debe decidir.
        </p>
      </div>

      <div class="space-y-8">
        {habilidades.map((hab) => (
          <div>
            <h3 class="text-cyan-400 font-mono text-xs uppercase tracking-widest mb-3">
              {hab.area}
            </h3>
            <div class="flex flex-wrap gap-2">
              {hab.items.map((item) => (
                <span class="px-3 py-1.5 bg-zinc-900 text-zinc-300 text-sm rounded-full border border-zinc-800 hover:border-cyan-400 transition">
                  {item}
                </span>
              ))}
            </div>
          </div>
        ))}
      </div>
    </div>
  </div>
</section>