---
const proyectos = [
  {
    titulo: 'X-Wing: Ruta Peligrosa',
    descripcion: 'Videojuego interactivo desarrollado en Scratch. La nave sigue el mouse del jugador y el objetivo es esquivar asteroides el mayor tiempo posible.',
    tipo: 'Videojuego · Scratch',
    url: 'https://scratch.mit.edu/projects/843592049/',
    embed: 'https://scratch.mit.edu/projects/843592049/embed',
    tags: ['Scratch', 'Lógica de juego', 'Interacción'],
  },
];
---

<section id="proyectos" class="py-32 px-6 bg-zinc-950 border-t border-zinc-900">
  <div class="max-w-7xl mx-auto">
    <p class="text-cyan-400 font-mono text-sm mb-4 tracking-widest uppercase">03 — Otros proyectos</p>
    <h2 class="text-5xl md:text-7xl font-bold text-white leading-tight mb-8 max-w-4xl">
      Otros proyectos <span class="text-cyan-400"> de mi</span>.
    </h2>
    <p class="text-xl text-zinc-400 max-w-3xl mb-16 leading-relaxed">
      Proyecto personal que refleja mi interés por la tecnología, la lógica de
      programación y la creación de videojuegos.
    </p>

    {proyectos.map((p) => (
      <div class="grid md:grid-cols-2 gap-12 items-start">
        <div>
          <p class="text-cyan-400 font-mono text-xs mb-3 uppercase tracking-wider">{p.tipo}</p>
          <h3 class="text-3xl md:text-4xl font-bold text-white mb-6">{p.titulo}</h3>
          <p class="text-zinc-400 text-lg leading-relaxed mb-8">{p.descripcion}</p>

          <div class="flex flex-wrap gap-2 mb-8">
            {p.tags.map((t) => (
              <span class="px-3 py-1.5 bg-zinc-900 text-zinc-300 text-sm rounded-full border border-zinc-800">
                {t}
              </span>
            ))}
          </div>

          <a
            href={p.url}
            target="_blank"
            rel="noopener"
            class="inline-block px-6 py-3 bg-white text-black font-semibold rounded-full hover:bg-cyan-400 transition"
          >
            Ver en Scratch →
          </a>
        </div>

        <div class="aspect-square bg-zinc-900 border border-zinc-800 rounded-lg overflow-hidden">
          <iframe
            src={p.embed}
            allowtransparency="true"
            width="100%"
            height="100%"
            frameborder="0"
            scrolling="no"
            allowfullscreen
          ></iframe>
        </div>
      </div>
    ))}
  </div>
</section>