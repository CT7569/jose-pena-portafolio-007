---
const links = [
  { href: '#perfil', label: 'Perfil' },
  { href: '#colchagua', label: 'Colchagua' },
  { href: '#proyectos', label: 'Proyectos' },
  { href: '#conclusiones', label: 'Conclusiones Caso' },
  { href: '#contacto', label: 'Contacto' },
];
---

<header class="fixed top-0 left-0 right-0 z-50 bg-black/80 backdrop-blur-md border-b border-zinc-800">
  <nav class="max-w-7xl mx-auto px-6 py-5 flex items-center justify-between">
    <a href="#" class="text-white font-bold text-lg tracking-tight">
      José Peña<span class="text-cyan-400">.</span>
    </a>
    <ul class="hidden md:flex gap-10">
      {links.map((link) => (
        <li>
          <a
            href={link.href}
            class="text-zinc-400 hover:text-white transition text-sm font-medium uppercase tracking-wider"
          >
            {link.label}
          </a>
        </li>
      ))}
    </ul>
  </nav>
</header>